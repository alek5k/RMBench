# Full-suite RMBench LTE SmolVLA recipe, aligned with SimpleMemVLA.
# Credentials remain only in scripts/lte/.env.
#
# SimpleMemVLA trains one RMBench model on this published, 10-task LeRobot-v3
# dataset. The bootstrap downloads it directly; it does not use the local
# per-task HDF5 conversion path.
RMBENCH_TASK=rmbench
RMBENCH_ENV_CFG=aloha_agilex
RMBENCH_DATASET_REPO_ID=yinchenghust/rmbench_lerobot
RMBENCH_SEED=429
RMBENCH_RUN_TAG=rmbench-lte-smolvla-simplememvla-8gpu-60k-sharded-cache-v9

RMBENCH_NUM_PROCESSES=8
RMBENCH_CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
TRAIN_NUM_WORKERS=32

# The published full-suite dataset has the same Aloha-AgileX feature schema.
RMBENCH_IMAGE_HEIGHT=240
RMBENCH_IMAGE_WIDTH=320
RMBENCH_STATE_ACTION_DIM=14

SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=30
SMOLVLA_N_ACTION_STEPS=30
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=false
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=false

# SimpleMemVLA's RMBench optimizer settings, mapped to SmolVLA/LTE modules.
SMOLVLA_OPTIMIZER_LR=5e-5
SMOLVLA_OPTIMIZER_WEIGHT_DECAY=1e-8
SMOLVLA_OPTIMIZER_GRAD_CLIP_NORM=1.0
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=60000
SMOLVLA_SCHEDULER_DECAY_LR=5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

TRAIN_STEPS=60000
TRAIN_SAVE_FREQ=3000
TRAIN_LOG_FREQ=10
LTE_BATCH_SIZE=8

# The full suite's longest demonstration is 2,436 frames. Keep complete
# causal history with headroom; the LTE loader verifies the actual maximum.
LTE_MAX_CAUSAL_HISTORY_LENGTH=4096
LTE_DIFFERENTIAL_LR=true
LTE_BACKBONE_LR_SCALE=0.1
# Detached cache construction is inference-only on 80 GB A100s. This does
# not affect the eight-sample optimizer batch used for training.
LTE_TEMPORAL_ENCODE_CHUNK_SIZE=128
# A complete detached history cache is built once before training. Rebuilding
# this 330k-frame table every 1,000 updates would dominate full-suite runtime.
LTE_TEMPORAL_EMBEDDING_CACHE_REFRESH_STEPS=60000
