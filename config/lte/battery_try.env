# Non-secret controls for one local RMBench task. Credentials are in scripts/lte/.env.
RMBENCH_TASK=battery_try
RMBENCH_ENV_CFG=aloha_agilex
RMBENCH_SEED=0
RMBENCH_RUN_TAG=smolvla-lte-100k-config-aligned-v1

# The dataset's raw, RGB camera frames and robot state/action width.  These
# make the baseline's declared feature schema match LTE's dataset-derived one.
RMBENCH_IMAGE_HEIGHT=240
RMBENCH_IMAGE_WIDTH=320
RMBENCH_STATE_ACTION_DIM=14

# Shared SmolVLA reference configuration.  The baseline loads this directly;
# LTE constructs its temporal wrapper, then strictly transplants these weights
# and inherited base-policy settings.  Keep common policy choices here.
SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=50
SMOLVLA_N_ACTION_STEPS=50
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=true
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=true
SMOLVLA_OPTIMIZER_LR=1e-4
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=30000
SMOLVLA_SCHEDULER_DECAY_LR=2.5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

# Both models receive this many optimizer updates.
TRAIN_STEPS=100000
TRAIN_SAVE_FREQ=10000
TRAIN_LOG_FREQ=10
SMOLVLA_BATCH_SIZE=32
LTE_BATCH_SIZE=8

# battery_try episodes reach 889 frames; LTE keeps complete episode histories.
LTE_MAX_CAUSAL_HISTORY_LENGTH=1024
