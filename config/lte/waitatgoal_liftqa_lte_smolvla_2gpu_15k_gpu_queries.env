# Joint WaitAtGoal + LiftQA LTE SmolVLA run. Credentials stay in
# scripts/lte/.env; this file contains only reproducible training controls.
RMBENCH_TASK=waitatgoal_liftqa
RMBENCH_ENV_CFG=temporal
# These existing local LeRobot-v3 exports are read directly; nothing is
# downloaded or copied to Brev for this profile.
RMBENCH_DATASET_REPO_IDS=waitatgoal_v4,liftqa_v2
RMBENCH_DATASET_ROOT=/home/sydney1/Repos/LTE-DP/datasets
# The adapter remains in its standalone repository during local development.
LTE_SMOLVLA_SOURCE=/home/sydney1/Repos/XPolicyLab/policy/LTE_SmolVLA
RMBENCH_SINGLE_CAMERA=true
RMBENCH_SEED=429
RMBENCH_RUN_TAG=waitatgoal-liftqa-lte-smolvla-2gpu-15k-gpu-queries-v1

# One torchrun process per GPU. Batch size is per process, so LTE encodes
# 8 x 16 = 128 temporal frames in its single vision call on each rank.
RMBENCH_NUM_PROCESSES=2
RMBENCH_CUDA_VISIBLE_DEVICES=0,1
TRAIN_NUM_WORKERS=8
SMOLVLA_CONDA_ENV=RMBench

RMBENCH_IMAGE_HEIGHT=144
RMBENCH_IMAGE_WIDTH=144
# WaitAtGoal is 2-D and LiftQA is 3-D; the joint adapter right-pads the
# WaitAtGoal state/action to this shared three-dimensional representation.
RMBENCH_STATE_ACTION_DIM=3

# Match the latest SimpleMemVLA-aligned SmolVLA setup: full action model and
# vision backbone finetuning, differential backbone LR, batch 8 per GPU.
SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=30
SMOLVLA_N_ACTION_STEPS=30
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=false
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=false
SMOLVLA_OPTIMIZER_LR=5e-5
SMOLVLA_OPTIMIZER_WEIGHT_DECAY=1e-8
SMOLVLA_OPTIMIZER_GRAD_CLIP_NORM=1.0
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=15000
SMOLVLA_SCHEDULER_DECAY_LR=5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

TRAIN_STEPS=15000
TRAIN_SAVE_FREQ=3000
TRAIN_LOG_FREQ=10
LTE_BATCH_SIZE=8

LTE_MAX_CAUSAL_HISTORY_LENGTH=512
LTE_DIFFERENTIAL_LR=true
LTE_BACKBONE_LR_SCALE=0.1
LTE_TEMPORAL_ENCODE_CHUNK_SIZE=128

# Use a raw uint8 GPU cache only. No visual embedding cache is allocated or
# rebuilt. Every update samples 16 history frames/example, gathers them from
# this GPU cache, and encodes all 128 frames/rank in one vision call.
LTE_TEMPORAL_EMBEDDING_CACHE_ENABLED=false
LTE_TEMPORAL_EMBEDDING_CACHE_REFRESH_STEPS=0
LTE_TEMPORAL_IMAGE_CACHE_ON_GPU=false
LTE_TEMPORAL_IMAGE_CACHE_IN_RAM=true
LTE_TEMPORAL_QUERY_HISTORY_ONLY=true
LTE_TEMPORAL_EMBEDDING_NORMALIZE=false
