# Joint WaitAtGoal + LiftQA LTE SmolVLA, direct image decode (no cache).
# Credentials remain in scripts/lte/.env.
RMBENCH_TASK=waitatgoal_liftqa
RMBENCH_ENV_CFG=temporal
RMBENCH_DATASET_REPO_IDS=waitatgoal_v4,liftqa_v2
RMBENCH_DATASET_ROOT=/home/sydney1/Repos/LTE-DP/datasets
LTE_SMOLVLA_SOURCE=/home/sydney1/Repos/XPolicyLab/policy/LTE_SmolVLA
RMBENCH_SINGLE_CAMERA=true
RMBENCH_SEED=429
RMBENCH_RUN_TAG=waitatgoal-liftqa-lte-smolvla-2gpu-20k-uncached-v5

# LeRobot's batch_size is per DDP process. Use 16 per GPU for the requested
# effective global batch of 32. Every rank encodes 16 x 16 = 256 temporal
# images in one vision call.
RMBENCH_NUM_PROCESSES=2
RMBENCH_CUDA_VISIBLE_DEVICES=0,1
TRAIN_NUM_WORKERS=8
SMOLVLA_CONDA_ENV=RMBench

RMBENCH_IMAGE_HEIGHT=144
RMBENCH_IMAGE_WIDTH=144
RMBENCH_STATE_ACTION_DIM=3

SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=30
SMOLVLA_N_ACTION_STEPS=30
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=false
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=false
SMOLVLA_OPTIMIZER_LR=5e-5
SMOLVLA_OPTIMIZER_WEIGHT_DECAY=1e-8
SMOLVLA_OPTIMIZER_GRAD_CLIP_NORM=1.0
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=20000
SMOLVLA_SCHEDULER_DECAY_LR=5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

TRAIN_STEPS=20000
TRAIN_SAVE_FREQ=5000
TRAIN_LOG_FREQ=10
LTE_BATCH_SIZE=16

LTE_MAX_CAUSAL_HISTORY_LENGTH=512
LTE_DIFFERENTIAL_LR=true
LTE_BACKBONE_LR_SCALE=0.1
# Exactly one temporal visual-encoder call for the 16 x 16 query frames.
LTE_TEMPORAL_ENCODE_CHUNK_SIZE=256

# Direct source reads: no embedding cache, no GPU cache, no shared-RAM cache.
LTE_TEMPORAL_EMBEDDING_CACHE_ENABLED=false
LTE_TEMPORAL_EMBEDDING_CACHE_REFRESH_STEPS=0
LTE_TEMPORAL_IMAGE_CACHE_ON_GPU=false
LTE_TEMPORAL_IMAGE_CACHE_IN_RAM=false
LTE_TEMPORAL_QUERY_HISTORY_ONLY=true
LTE_TEMPORAL_EMBEDDING_NORMALIZE=false
