# Non-secret controls for the RMBench Blocks Ranking task. Credentials are in
# scripts/lte/.env. This run is isolated from the battery_try checkpoints.
RMBENCH_TASK=blocks_ranking_try
RMBENCH_ENV_CFG=aloha_agilex
RMBENCH_SEED=0
RMBENCH_RUN_TAG=blocks-ranking-smolvla-lte-100k-v1
# Do not contend with a simulator rollout already using this L40S. Setup and
# conversion may proceed, but training starts only after active eval screens exit.
RMBENCH_WAIT_FOR_EVALS=true

# RMBench Aloha demonstrations use three 240x320 RGB cameras and 14-DoF
# state/action vectors. These shared features are identical for SmolVLA and LTE.
RMBENCH_IMAGE_HEIGHT=240
RMBENCH_IMAGE_WIDTH=320
RMBENCH_STATE_ACTION_DIM=14

# Shared SmolVLA reference configuration. LTE inherits this base policy and
# adds only its temporal module.
SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=50
SMOLVLA_N_ACTION_STEPS=50
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=true
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=true
SMOLVLA_OPTIMIZER_LR=1e-4
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=30000
SMOLVLA_SCHEDULER_DECAY_LR=2.5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

# Both models receive the same number of optimizer updates and checkpoint cadence.
TRAIN_STEPS=100000
TRAIN_SAVE_FREQ=10000
TRAIN_LOG_FREQ=10
SMOLVLA_BATCH_SIZE=32
LTE_BATCH_SIZE=8

# LTE keeps complete causal episode histories. The ceiling covers the task's
# 3500-step evaluation budget without truncating a longer demonstration.
LTE_MAX_CAUSAL_HISTORY_LENGTH=4096
