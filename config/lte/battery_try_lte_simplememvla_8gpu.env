# LTE SmolVLA, RMBench battery_try, on one eight-GPU Brev instance.
# Credentials remain only in scripts/lte/.env.
#
# This mirrors the executable SimpleMemVLA RMBench recipe where SmolVLA has an
# equivalent control: 8 samples/GPU, 60k optimiser updates, 3k-step saves,
# 1k warmup, and a cosine floor at 10% of each parameter group's peak LR.
RMBENCH_TASK=battery_try
RMBENCH_ENV_CFG=aloha_agilex
RMBENCH_SEED=429
RMBENCH_RUN_TAG=lte-smolvla-simplememvla-8gpu-60k-v1

# One process per GPU. The launcher verifies that the Brev machine exposes at
# least this many GPUs before loading the policy.
RMBENCH_NUM_PROCESSES=8
RMBENCH_CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
TRAIN_NUM_WORKERS=32

RMBENCH_IMAGE_HEIGHT=240
RMBENCH_IMAGE_WIDTH=320
RMBENCH_STATE_ACTION_DIM=14

# SimpleMemVLA predicts 30 actions per call. LTE keeps its own SmolVLA action
# expert and temporal modules, but uses the same prediction horizon.
SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=30
SMOLVLA_N_ACTION_STEPS=30
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=false
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=false

# SimpleMemVLA fine-tunes its Qwen backbone at 5e-6 and its action head at
# 5e-5. LTE now makes that same split: SmolVLA VLM (including vision) gets
# 5e-6, while the action expert, state projector, and LTE modules get 5e-5.
# Pinned SmolVLA retains its small DDP-safety exclusions in the final VLM.
SMOLVLA_OPTIMIZER_LR=5e-5
SMOLVLA_OPTIMIZER_WEIGHT_DECAY=1e-8
SMOLVLA_OPTIMIZER_GRAD_CLIP_NORM=1.0
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=60000
SMOLVLA_SCHEDULER_DECAY_LR=5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

TRAIN_STEPS=60000
TRAIN_SAVE_FREQ=3000
TRAIN_LOG_FREQ=10
SMOLVLA_BATCH_SIZE=8
LTE_BATCH_SIZE=8

# battery_try's longest demonstration is 889 frames (~59 s at 15 Hz), close
# to SimpleMemVLA's 60-second history. LTE preserves the complete causal
# history from all three cameras; it cannot use image augmentation because the
# temporal cache requires stable per-frame embeddings.
LTE_MAX_CAUSAL_HISTORY_LENGTH=1024
LTE_DIFFERENTIAL_LR=true
LTE_BACKBONE_LR_SCALE=0.1
# History targets are detached cached visual embeddings. Rebuild them every
# 1,000 optimizer updates so they remain reasonably aligned to the unfrozen
# vision encoder without rebuilding on every step.
LTE_TEMPORAL_EMBEDDING_CACHE_REFRESH_STEPS=1000
