# Isolated baseline-only battery_try run. Credentials remain in scripts/lte/.env.
RMBENCH_TASK=battery_try
RMBENCH_ENV_CFG=aloha_agilex
RMBENCH_SEED=0
RMBENCH_RUN_TAG=smolvla-batch8-100k-v1

RMBENCH_IMAGE_HEIGHT=240
RMBENCH_IMAGE_WIDTH=320
RMBENCH_STATE_ACTION_DIM=14

SMOLVLA_BASE_POLICY=lerobot/smolvla_base
SMOLVLA_CHUNK_SIZE=50
SMOLVLA_N_ACTION_STEPS=50
SMOLVLA_N_OBS_STEPS=1
SMOLVLA_TRAIN_EXPERT_ONLY=true
SMOLVLA_TRAIN_STATE_PROJ=true
SMOLVLA_FREEZE_VISION_ENCODER=true
SMOLVLA_OPTIMIZER_LR=1e-4
SMOLVLA_SCHEDULER_WARMUP_STEPS=1000
SMOLVLA_SCHEDULER_DECAY_STEPS=30000
SMOLVLA_SCHEDULER_DECAY_LR=2.5e-6
SMOLVLA_ADAPT_TO_PI_ALOHA=false
SMOLVLA_USE_DELTA_JOINT_ACTIONS_ALOHA=false

TRAIN_STEPS=100000
TRAIN_SAVE_FREQ=10000
TRAIN_LOG_FREQ=10
SMOLVLA_BATCH_SIZE=8

# Unused by the baseline launch, retained so this configuration remains valid
# if it is later compared with LTE through the shared launcher.
LTE_BATCH_SIZE=8
LTE_MAX_CAUSAL_HISTORY_LENGTH=1024
